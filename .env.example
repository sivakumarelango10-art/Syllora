# ============================================================================
# SYLLORA — ENVIRONMENT CONFIGURATION TEMPLATE (.env.example)
# ============================================================================
# Safe, complete template documenting every supported environment variable.
# Copy this file to '.env' at the repository root and fill in your actual credentials:
#     Copy-Item .env.example .env
#
# NEVER commit the root '.env' file containing real secret keys or passwords.
# ============================================================================

# ==========================================
# 1. APPLICATION & RUNTIME METADATA
# ==========================================
APP_NAME=Syllora
APP_ENV=development
LOG_LEVEL=INFO
SYLLORA_REQUIRE_AUTH=true

# ==========================================
# 2. FASTAPI BACKEND SERVER CONFIGURATION
# ==========================================
API_HOST=127.0.0.1
API_PORT=8000
PUBLIC_API_BASE_URL=http://127.0.0.1:8000

# Comma-separated list of allowed frontend origin domains for CORS.
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173,http://127.0.0.1:5173,http://localhost:8080,http://127.0.0.1:8080,https://syllora-seven.vercel.app

# ==========================================
# 3. FRONTEND PUBLIC BROWSER CONFIGURATION
# Safe variables built into public frontend bundles.
# ==========================================
PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_ID.supabase.co
PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_YOUR_ANON_OR_PUBLISHABLE_KEY

# ==========================================
# 4. SUPABASE SERVER & AUTH CONFIGURATION
# ==========================================
SUPABASE_URL=https://YOUR_PROJECT_ID.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_YOUR_ANON_OR_PUBLISHABLE_KEY

# Privileged service role key (OPTIONAL: Server-side only; NEVER expose to browser)
SUPABASE_SECRET_KEY=

# Storage bucket configured for academic PDFs
SUPABASE_STORAGE_BUCKET=syllora-study-pdfs

# JWT Authentication verification
SUPABASE_JWT_AUDIENCE=authenticated
SUPABASE_JWT_ISSUER=
SUPABASE_JWKS_URL=https://YOUR_PROJECT_ID.supabase.co/auth/v1/.well-known/jwks.json

# ==========================================
# 5. POSTGRESQL DATABASE CONFIGURATION
# Active database provider ('postgres' or 'sqlite')
# ==========================================
SYLLORA_DB_PROVIDER=postgres

# Transaction-mode connection pooler for runtime application queries (IPv4 pooler port 6543)
DATABASE_URL=postgresql://postgres.YOUR_PROJECT_ID:[YOUR-PASSWORD]@aws-0-ap-northeast-1.pooler.supabase.com:6543/postgres?pgbouncer=true

# Session-mode connection pooler for schema migrations and direct DDL (port 5432)
DIRECT_URL=postgresql://postgres.YOUR_PROJECT_ID:[YOUR-PASSWORD]@aws-0-ap-northeast-1.pooler.supabase.com:5432/postgres

# Local SQLite fallback path (used when SYLLORA_DB_PROVIDER=sqlite)
SYLLORA_DB_PATH=backend/data/indexes/syllora.sqlite3
SQLITE_PATH=backend/data/indexes/syllora.sqlite3

# ==========================================
# 6. OLLAMA / LOCAL PRIVATE AI SERVER
# ==========================================
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3:4b
OLLAMA_CHAT_MODEL=qwen3:4b
OLLAMA_EMBED_MODEL=nomic-embed-text
EMBEDDING_DIM=768
OLLAMA_TIMEOUT_SECONDS=120

# ==========================================
# 7. DOCUMENTS & STORAGE CONFIGURATION
# ==========================================
SYLLORA_STORAGE_PROVIDER=supabase
SYLLORA_MAX_UPLOAD_MB=20
MAX_UPLOAD_MB=20
SYLLORA_MAX_PDF_PAGES=500
SYLLORA_MAX_CHUNKS_PER_DOCUMENT=1200
SYLLORA_UPLOAD_DIR=backend/data/uploads
LOCAL_UPLOAD_DIR=backend/data/uploads

# ==========================================
# 8. SECURITY & CONCURRENCY LIMITS
# ==========================================
AI_RATE_LIMIT_RPM=30
STANDARD_RATE_LIMIT_RPM=120
REQUEST_TIMEOUT_SECONDS=60
SYLLORA_MAX_CONCURRENT_INFERENCES=3

# ==========================================
# 9. DEVELOPMENT & DIAGNOSTICS
# ==========================================
ENABLE_API_DOCS=true
ENABLE_DEBUG_LOGGING=false
