# Database modes. Current app uses SQLite by default; keep it intact until migration is validated.
SYLLORA_DB_PROVIDER=sqlite
SYLLORA_DB_PATH=F:/Syllora/backend/data/indexes/syllora.sqlite3
SYLLORA_STORAGE_PROVIDER=local
SYLLORA_UPLOAD_DIR=F:/Syllora/backend/data/uploads

# Hosted Supabase PostgreSQL Configuration:
# SYLLORA_DB_PROVIDER=postgres
# Direct Connection (default port 5432):
# DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.lgiarosqejiaejizrxdu.supabase.co:5432/postgres
# Transaction Pooler (recommended for IPv4 networks & high concurrency):
# DATABASE_URL=postgresql://postgres.lgiarosqejiaejizrxdu:[YOUR-PASSWORD]@aws-0-ap-northeast-1.pooler.supabase.com:6543/postgres?pgbouncer=true
# Session Mode Pooler (for DDL & migrations):
# DIRECT_URL=postgresql://postgres.lgiarosqejiaejizrxdu:[YOUR-PASSWORD]@aws-0-ap-northeast-1.pooler.supabase.com:5432/postgres



