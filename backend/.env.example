# Local Ollama server and chat model
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=syllora-qwen
OLLAMA_TIMEOUT_SECONDS=180

# Embedding model used to index documents at upload time
OLLAMA_EMBED_MODEL=nomic-embed-text
OLLAMA_EMBED_TIMEOUT_SECONDS=300

# Local storage locations (relative defaults are based on this backend folder)
# SYLLORA_DB_PATH=F:/Syllora/backend/data/indexes/syllora.sqlite3
# SYLLORA_UPLOAD_DIR=F:/Syllora/backend/data/uploads

# Upload guardrails
SYLLORA_MAX_UPLOAD_MB=20
SYLLORA_MAX_PDF_PAGES=500
SYLLORA_MAX_CHUNKS_PER_DOCUMENT=1200
